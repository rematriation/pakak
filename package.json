    "mongodb": "^6.16.0",
    "twilio": "^5.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "ts-node": "^10.9.1",
    "@types/node": "^20.4.2",
    "eslint": "^8.45.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "@types/jest": "^29.5.14",
    "serverless": "^4.15.1",
    "serverless-offline": "^14.4.0",
