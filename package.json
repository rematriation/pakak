{
  "name": "nalukataq",
  "version": "0.1.0",
  "description": "Serverless SMS/MMS archiving prototype for REMA",
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint . --ext .ts",
    "test": "jest --passWithNoTests",
    "offline": "sls offline --stage dev",
    "deploy:dev": "npm run build && sls deploy --stage dev",
    "deploy:prod": "npm run build && sls deploy --stage prod",
    "clean": "rm -rf .serverless node_modules dist",
    "format": "prettier --ignore-path .gitignore --write '**/*.+(js|ts|json)'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.817.0",
    "@aws-sdk/client-s3": "^3.820.0",
    "@aws-sdk/client-sqs": "^3.817.0",
    "@aws-sdk/util-dynamodb": "^3.817.0",
    "mongodb": "^6.16.0",
    "pino": "^9.7.0",
    "twilio": "^5.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.4.2",
    "@types/pino": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^8.45.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "serverless": "^4.15.1",
    "serverless-localstack": "^1.3.1",
    "serverless-offline": "^14.4.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
